# Copia a .env (NUNCA subas .env al repo)
# En EC2/prod: variables de entorno o Secrets Manager + IAM Role

DB_HOST=tu-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=sirma
DB_USERNAME=admin
DB_PASSWORD=cambia_esto

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@ejemplo.com
MAIL_PASSWORD=tu_app_password

APP_LOGIN_URL=http://localhost:5173/login
APP_RESET_BASE_URL=http://localhost:5173

JWT_SECRET=cambia_por_una_clave_larga_aleatoria
JWT_EXPIRATION=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# En EC2 con IAM Role: deja vacías las access keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=sirma-activos
